MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/tsag
AUTH_SECRET=            # npx auth secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
ADMIN_EMAILS=you@example.com
CRON_SECRET=
NEXT_PUBLIC_APP_NAME=Цаг
DEV_LOGIN=false          # true бол local-д seed хэрэглэгчээр нэвтэрнэ (production-д үл хамаарна)

# Android (TWA) апп
ANDROID_PACKAGE_NAME=mn.tsag.app
ANDROID_CERT_SHA256=     # таслалаар тусгаарласан SHA-256 fingerprint

# Төлбөрийн Telegram баталгаажуулалт
TELEGRAM_BOT_TOKEN=          # @BotFather-оос
TELEGRAM_CHAT_ID=            # мессеж очих chat ID (таслалаар хэд хэдийг)
TELEGRAM_WEBHOOK_SECRET=     # дурын урт санамсаргүй текст (товчны хамгаалалт)
NEXT_PUBLIC_TELEGRAM_CONTACT= # ажил олгогч холбогдох Telegram username (жишээ: sanjid)
